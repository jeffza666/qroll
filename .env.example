# ============================================
# Qroll - Environment Variables Template
# ============================================
# Copy this file to .env.local, then fill in real values.
# Never commit .env.local or real secrets.

# ============================================
# Database (Supabase PostgreSQL)
# Settings > Database > Connection string
# ============================================
# Pooled connection - used by the Next.js runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection - used only by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ============================================
# NextAuth.js v5 (Auth.js)
# ============================================
NEXTAUTH_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Local dev only: true lets seed users log in without calling TU API.
BYPASS_TU_AUTH=false

# ============================================
# TU API (Thammasat University Authentication)
# See docs/prps/02-auth-tu-api.md
# ============================================
TU_API_URL="https://restapi.tu.ac.th/api/v1/auth/Ad/verify"
TU_API_KEY=""
