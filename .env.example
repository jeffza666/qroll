# ============================================
# Qroll — Environment Variables Template
# ============================================
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
# ห้าม commit .env.local ขึ้น Git เด็ดขาด

# ============================================
# Database (Supabase PostgreSQL)
# Settings > Database > Connection string
# ============================================
# Pooled connection — ใช้ตอน runtime (Next.js app)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection — ใช้ตอนรัน prisma migrate เท่านั้น
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ============================================
# NextAuth.js v5 (Auth.js)
# ============================================
NEXTAUTH_URL="http://localhost:3000"

# สร้างด้วย: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ============================================
# TU API (Thammasat University Authentication)
# ดูรายละเอียดใน docs/prps/02-auth-tu-api.md
# ============================================
TU_API_CLIENT_ID=""
TU_API_CLIENT_SECRET=""
TU_API_BASE_URL=""
