// prisma/schema.prisma
// Blueprint: docs/prps/01-database-schema.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// ENUMS
// ============================================

enum Role {
  TEACHER
  STUDENT
}

enum AttendanceStatus {
  PRESENT // เช็คอินทันเวลา
  LATE // เช็คอินสายตามเกณฑ์ที่อาจารย์กำหนด
  ABSENT // ไม่ได้เช็คอินจนคาบเรียนปิด (สร้างโดย system job)
  EXCUSED // ลาป่วย/ลากิจ — กรอกโดยอาจารย์เท่านั้น ไม่ auto-mark
}

// ============================================
// USER (Teacher + Student)
// ============================================

model User {
  id        String   @id @default(cuid())
  email     String?  @unique // STUDENT pre-import can be null until first TU login links email
  name      String
  studentId String?  @unique // null สำหรับ TEACHER, unique สำหรับ STUDENT
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NextAuth relations (ถ้าใช้ database adapter)
  accounts Account[]
  sessions Session[] // NextAuth Session — ไม่ใช่ ClassSession ของเรา

  // Domain relations
  taughtCourses Course[]     @relation("CourseTeacher")
  enrollments   Enrollment[]
  attendances   Attendance[]

  @@index([role])
  @@index([studentId])
}

// ============================================
// COURSE
// ============================================

model Course {
  id        String   @id @default(cuid())
  code      String // เช่น "CS101" — ไม่ unique global เผื่อข้ามเทอม
  section   String? // เช่น "650001" — section/sec ของวิชา (optional)
  name      String
  semester  String // เช่น "1/2026"
  teacherId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // archivedAt: ถ้า not null = วิชาถูก archive (ซ่อนจาก default view + เปิด session ใหม่ไม่ได้)
  // ใช้ DateTime แทน boolean เพื่อเก็บ audit trail ว่า archive เมื่อไหร่
  archivedAt DateTime?

  teacher       User           @relation("CourseTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  enrollments   Enrollment[]
  schedules     Schedule[]
  classSessions ClassSession[]

  @@unique([code, semester, teacherId]) // กันสร้างวิชาซ้ำต่อเทอมต่ออาจารย์
  @@index([teacherId])
  @@index([semester])
  @@index([archivedAt])
}

// ============================================
// ENROLLMENT (M:N User<->Course)
// ============================================

model Enrollment {
  id        String    @id @default(cuid())
  studentId String
  courseId  String
  droppedAt DateTime? // null = active, value = ถอนออกเมื่อเวลานั้น (soft delete)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  student User   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId]) // ❗ กันลงทะเบียนซ้ำ
  @@index([courseId])
  @@index([studentId])
  @@index([droppedAt])
}

// ============================================
// SCHEDULE (ตารางสอนรายสัปดาห์ recurring)
// ============================================

model Schedule {
  id        String  @id @default(cuid())
  courseId  String
  dayOfWeek Int // 0=Sun, 1=Mon, ..., 6=Sat (ตรงกับ JS Date.getDay())
  startTime String // "HH:MM" 24h เช่น "09:00"
  endTime   String // "HH:MM" 24h เช่น "12:00"
  room      String? // optional เช่น "SC-3001"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course        Course         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  classSessions ClassSession[]

  @@index([courseId])
  @@index([dayOfWeek])
}

// ============================================
// CLASS SESSION (คาบเรียน — เปลี่ยนชื่อจาก "Session")
// ============================================

model ClassSession {
  id              String    @id @default(cuid())
  courseId        String
  scheduleId      String? // Phase 6: nullable — รองรับ ad-hoc session + รองรับการลบ schedule (SetNull)
  startsAt        DateTime // เวลาเริ่มคาบ (server time = ตอนกดเปิด)
  endsAt          DateTime // เวลาจบคาบ = startsAt + durationMinutes
  durationMinutes Int       @default(0) // Phase 6: ระยะเวลาเปิด QR (นาที) — audit
  lateAfter       DateTime? // ถ้า null = ไม่แยก LATE (ทันเวลาทุกคนใน duration)
  graceMinutes    Int? // Phase 6: ถ้า null = ไม่แยก LATE; ถ้ามีค่า = นาทีที่ยังถือว่าทันเวลา
  roomSnapshot    String? // ห้องที่ snapshot ตอนเปิด session — ไม่เปลี่ยนแม้แก้ Schedule ภายหลัง (historical truth)

  // Static check-in token and fallback code for the whole open session.
  qrToken   String? @unique
  entryCode String?

  isOpen    Boolean   @default(true) // false = ปิดคาบ ไม่รับ check-in อีก
  closedAt  DateTime? // เวลาปิดจริง (manual หรือ auto-close)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  schedule     Schedule?     @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  attendances  Attendance[]
  demoCheckIns DemoCheckIn[]
  // ❗ Partial unique index: 1 open session per course — เขียนเป็น raw SQL ใน migration
  // CREATE UNIQUE INDEX "ClassSession_one_open_per_course" ON "ClassSession"("courseId") WHERE "isOpen" = true;

  @@index([courseId])
  @@index([scheduleId])
  @@index([startsAt])
  @@index([qrToken])
  @@index([entryCode])
}

// ============================================
// ATTENDANCE (การเช็คอิน)
// ============================================

model Attendance {
  id             String           @id @default(cuid())
  classSessionId String
  studentId      String
  status         AttendanceStatus @default(PRESENT)
  checkedInAt    DateTime         @default(now()) // server time — ห้ามเชื่อ client
  ipAddress      String? // forensics (optional)
  userAgent      String? // forensics (optional)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  student      User         @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([classSessionId, studentId]) // ❗❗❗ กัน race condition + replay attack
  @@index([studentId])
  @@index([classSessionId])
}

// ============================================
// DEMO CHECK-IN (public showcase data, separate from real Attendance)
// ============================================

model DemoCheckIn {
  id             String   @id @default(cuid())
  classSessionId String
  displayName    String
  checkedInAt    DateTime @default(now())
  ipAddress      String?
  userAgent      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)

  @@index([classSessionId])
  @@index([checkedInAt])
}

// ============================================
// NEXTAUTH ADAPTER MODELS (Auth.js v5 standard)
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  // ⚠️ NextAuth Session — อย่าสับสนกับ ClassSession ของเรา
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
